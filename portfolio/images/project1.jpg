<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="100%" height="100%">
  <defs>
    <linearGradient id="p1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1e293b"/>
      <stop offset="100%" stop-color="#0f172a"/>
    </linearGradient>
    <linearGradient id="gold" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#f59e0b"/>
      <stop offset="100%" stop-color="#d97706"/>
    </linearGradient>
  </defs>
  <rect width="600" height="400" fill="url(#p1)"/>
  <!-- Top Bar -->
  <rect x="0" y="0" width="600" height="45" fill="#0f172a"/>
  <circle cx="30" cy="22.5" r="6" fill="#ef4444"/>
  <circle cx="50" cy="22.5" r="6" fill="#f59e0b"/>
  <circle cx="70" cy="22.5" r="6" fill="#10b981"/>
  <rect x="100" y="12" width="400" height="20" rx="6" fill="#1e293b"/>
  
  <!-- Content -->
  <text x="300" y="160" font-family="'Poppins', sans-serif" font-weight="bold" font-size="28" fill="url(#gold)" text-anchor="middle">JUSTICE &amp; ASSOCIATES</text>
  <text x="300" y="195" font-family="'Poppins', sans-serif" font-size="16" fill="#94a3b8" text-anchor="middle">Corporate Law &amp; Legal Consulting</text>

  <!-- Balance Scale Icon -->
  <path d="M 300 230 L 300 300 M 250 250 L 350 250 M 250 250 L 230 280 M 250 250 L 270 280 M 350 250 L 330 280 M 350 250 L 370 280 M 270 300 L 330 300" stroke="#f59e0b" stroke-width="4" stroke-linecap="round" fill="none"/>
</svg>
